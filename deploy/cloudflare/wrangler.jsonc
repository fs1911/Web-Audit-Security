// Cloudflare-Konfiguration für den bestehenden Worker «web-audit-security».
// STATUS: geschrieben, aber NICHT deployt und NICHT gegen ein Konto getestet.
// Platzhalter (<…>) müssen vor dem ersten Deployment ersetzt werden – siehe docs/deployment.md.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "web-audit-security",
  "main": "src/entry.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../../.open-next/assets", "binding": "ASSETS" },

  // Postgres (extern, z. B. eigenes Supabase-/Neon-Projekt) über Hyperdrive.
  // NICHT die bestehende Hyperdrive-Konfiguration «baustellenkontrolle-db» verwenden.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_ID_WEBAUDIT>" }],

  // Private Berichtsablage. R2 ist im Konto aktuell NICHT aktiviert (Dashboard → R2 → aktivieren).
  "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "web-audit-security-reports" }],

  // Scan-Runner als Container (benötigt Workers-Paid-Plan).
  "containers": [
    {
      "class_name": "ScanRunnerContainer",
      "image": "../docker/Dockerfile.runner",
      "image_build_context": "../..",
      "instance_type": "standard-1",
      "max_instances": 2
    }
  ],
  "durable_objects": { "bindings": [{ "name": "SCAN_RUNNER", "class_name": "ScanRunnerContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScanRunnerContainer"] }],

  // Dispatcher: jede Minute Warteschlange abarbeiten und hängende Scans beenden.
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    "WEBAUDIT_ENV": "production",
    "NODE_ENV": "production",
    "STORAGE_DRIVER": "s3",
    "ENABLE_ACTIVE_SCANS": "false",
    "ALLOW_REGISTRATION": "false",
    "RUNNER_MAX_CONCURRENT": "1"
  }
  // Secrets (wrangler secret put …): APP_ENCRYPTION_KEY, RUNNER_CALLBACK_SECRET, RUNNER_SHARED_SECRET,
  // S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, APP_URL, optional ANTHROPIC_API_KEY
}
