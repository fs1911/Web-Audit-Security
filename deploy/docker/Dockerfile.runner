# Scan-Runner-Image: OWASP ZAP (offizielles Image, Version fixiert) + Node.js + Repo-Scanner.
# Wird in Cloudflare Containers bzw. docker compose verwendet. Gebaut im GitHub-Actions-Workflow cf-deploy.yml.
FROM zaproxy/zap-stable:2.17.0
USER root
ARG NODE_MAJOR=22
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git python3-pip \
 && curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && pip3 install --break-system-packages --no-cache-dir semgrep==1.180.0 \
 && rm -rf /var/lib/apt/lists/*
# gitleaks / osv-scanner als fixierte Release-Binaries
ARG GITLEAKS_VERSION=8.30.1
ARG OSV_VERSION=2.7.0
RUN curl -fsSL -o /tmp/gl.tgz https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz \
 && tar -xzf /tmp/gl.tgz -C /usr/local/bin gitleaks && rm /tmp/gl.tgz \
 && curl -fsSL -o /usr/local/bin/osv-scanner https://github.com/google/osv-scanner/releases/download/v${OSV_VERSION}/osv-scanner_linux_amd64 \
 && chmod +x /usr/local/bin/osv-scanner
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm i --no-save tsx@4
COPY src ./src
COPY catalog ./catalog
COPY rules ./rules
ENV ZAP_HOME_DIR=/zap NODE_ENV=production RUNNER_HOST=0.0.0.0 RUNNER_PORT=8787 SEMGREP_RULES=/app/rules/semgrep
USER zap
EXPOSE 8787
CMD ["npx", "tsx", "src/runner/server.ts"]
