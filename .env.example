# ---- WebAudit Security – Beispielkonfiguration (KEINE echten Secrets eintragen) ----
NODE_ENV=development
# Postgres (lokal oder z. B. Neon/Supabase; in Cloudflare über Hyperdrive)
DATABASE_URL=postgres://webaudit:webaudit@localhost:5432/webaudit
# 32 Byte base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# mind. 32 Zeichen, zufällig
RUNNER_CALLBACK_SECRET=
RUNNER_SHARED_SECRET=
# Öffentliche URL der App und URL, unter der der Runner die App erreicht
APP_URL=http://127.0.0.1:3000
APP_INTERNAL_URL=http://127.0.0.1:3000
RUNNER_URL=http://127.0.0.1:8787
RUNNER_PORT=8787
RUNNER_MAX_CONCURRENT=1
MAX_CONCURRENT_SCANS_PER_ORG=2
# OWASP ZAP Installationsverzeichnis (enthält zap-<version>.jar)
ZAP_HOME_DIR=/opt/zap
# Eigener Semgrep-Regelsatz (Standard: ./rules/semgrep)
SEMGREP_RULES=./rules/semgrep
# Objektspeicher: fs (lokal) oder s3 (Cloudflare R2)
STORAGE_DRIVER=fs
STORAGE_DIR=./var/storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Aktive Prüfungen (Modus C) – standardmässig aus
ENABLE_ACTIVE_SCANS=false
ALLOW_ACTIVE_ON_PRODUCTION=false
# Registrierung offen? (für Einzelnutzung nach dem ersten Konto auf false setzen)
ALLOW_REGISTRATION=true
# Optionale KI-Erklärungen (Anthropic). Ohne Schlüssel funktionieren Scans und Berichte vollständig.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- NUR für lokale Entwicklung/Tests – in production wirkungslos ----
# Erlaubt das lokale Testziel (testtarget) trotz SSRF-Schutz
NETGUARD_TEST_ALLOW_CIDRS=
NETGUARD_TEST_ALLOW_PORTS=
WEBAUDIT_ALLOW_INVALID_CERTS=false
WEBAUDIT_HTTP_PROBE_PORT=
